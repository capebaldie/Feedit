# Server-only. Never prefix these with VITE_ — that would inline them into the
# client bundle at build time and publish them to every visitor.

# Reddit session cookie. Anonymous Reddit JSON requests return 403, so the
# proxy needs this. A full session cookie runs to several kilobytes.
REDDIT_COOKIE=

# The code you type on the login screen. Compared server-side in api/login.ts.
# A long passphrase is far stronger than a short numeric code.
ACCESS_CODE=

# HMAC key used to sign session cookies. Any long random string.
# Rotating this revokes every active session immediately.
SESSION_SECRET=